rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUser(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'isAnonymous', 'providers', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && (request.resource.data.email == null
          || request.resource.data.email is string)
        && request.resource.data.isAnonymous is bool
        && request.resource.data.providers is list
        && request.resource.data.providers.size() <= 10
        && request.resource.data.updatedAt is timestamp;
    }

    function validSettings(settings) {
      return settings is map
        && settings.keys().hasOnly([
          'darkMode', 'focusReminders', 'autoStartBreaks',
          'dailyGoalMinutes', 'defaultFocusMinutes', 'shortBreakMinutes',
          'sleepTimerMinutes'
        ])
        && settings.darkMode is bool
        && settings.focusReminders is bool
        && settings.autoStartBreaks is bool
        && settings.dailyGoalMinutes is int
        && settings.dailyGoalMinutes >= 1
        && settings.dailyGoalMinutes <= 1440
        && settings.defaultFocusMinutes is int
        && settings.defaultFocusMinutes >= 1
        && settings.defaultFocusMinutes <= 1440
        && settings.shortBreakMinutes is int
        && settings.shortBreakMinutes >= 1
        && settings.shortBreakMinutes <= 180
        && settings.sleepTimerMinutes is int
        && settings.sleepTimerMinutes >= 1
        && settings.sleepTimerMinutes <= 480;
    }

    function validRitualSounds(sounds) {
      return sounds is map
        && sounds.keys().hasOnly(['rain', 'fire', 'forest', 'piano'])
        && sounds.size() <= 2
        && (!sounds.keys().hasAny(['rain'])
          || (sounds.rain is number && sounds.rain > 0 && sounds.rain <= 1))
        && (!sounds.keys().hasAny(['fire'])
          || (sounds.fire is number && sounds.fire > 0 && sounds.fire <= 1))
        && (!sounds.keys().hasAny(['forest'])
          || (sounds.forest is number && sounds.forest > 0 && sounds.forest <= 1))
        && (!sounds.keys().hasAny(['piano'])
          || (sounds.piano is number && sounds.piano > 0 && sounds.piano <= 1));
    }

    function validRitual(ritual) {
      return ritual is map
        && ritual.keys().hasOnly([
          'id', 'templateKey', 'customName', 'focusMinutes', 'breakMinutes',
          'soundVolumes'
        ])
        && ritual.id is string
        && ritual.id.size() > 0
        && ritual.id.size() <= 64
        && (ritual.templateKey == null
          || ritual.templateKey in ['study', 'reading', 'deepFocus'])
        && (ritual.customName == null
          || (ritual.customName is string
            && ritual.customName.size() > 0
            && ritual.customName.size() <= 30))
        && ritual.focusMinutes in [15, 25, 45, 60, 75, 90]
        && ritual.breakMinutes in [5, 10, 15]
        && validRitualSounds(ritual.soundVolumes);
    }

    function validFocusRituals(collection) {
      return collection is map
        && collection.keys().hasOnly([
          'items', 'selectedRitualId', 'updatedAtEpochMs'
        ])
        && collection.items is list
        && collection.items.size() <= 5
        && (collection.selectedRitualId == null
          || (collection.selectedRitualId is string
            && collection.selectedRitualId.size() <= 64))
        && collection.updatedAtEpochMs is int
        && collection.updatedAtEpochMs >= 0
        && (collection.items.size() < 1 || validRitual(collection.items[0]))
        && (collection.items.size() < 2 || validRitual(collection.items[1]))
        && (collection.items.size() < 3 || validRitual(collection.items[2]))
        && (collection.items.size() < 4 || validRitual(collection.items[3]))
        && (collection.items.size() < 5 || validRitual(collection.items[4]));
    }

    function validProgressDocument() {
      let data = request.resource.data;
      let progress = data.progress;
      return data.keys().hasOnly(['progress', 'updatedAt'])
        && data.updatedAt is timestamp
        && progress is map
        && progress.keys().hasOnly([
          'schemaVersion', 'username', 'profileAvatarId', 'settings',
          'dailyMinutes', 'selectedDecorationIds', 'decorationPositions',
          'craftProgress', 'inventory', 'pendingRewards', 'roomPlacements',
          'badges', 'dailyReward', 'focusRituals'
        ])
        && progress.schemaVersion is int
        && progress.schemaVersion == 4
        && progress.username is string
        && progress.username.size() > 0
        && progress.username.size() <= 80
        && progress.profileAvatarId is string
        && progress.profileAvatarId.size() <= 40
        && validSettings(progress.settings)
        && progress.dailyMinutes is map
        && progress.selectedDecorationIds is list
        && progress.selectedDecorationIds.size() <= 100
        && progress.decorationPositions is map
        && progress.craftProgress is map
        && progress.inventory is map
        && progress.pendingRewards is list
        && progress.pendingRewards.size() <= 100
        && progress.roomPlacements is map
        && progress.badges is map
        && progress.dailyReward is map
        && validFocusRituals(progress.focusRituals);
    }

    function validFocusSession() {
      let data = request.resource.data;
      return data.keys().hasOnly(['minutes', 'completedAt', 'createdAt'])
        && data.minutes is int
        && data.minutes > 0
        && data.minutes <= 1440
        && data.completedAt is timestamp
        && data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validUser(uid);

      match /state/{stateId} {
        allow read, delete: if owns(uid) && stateId == 'progress';
        allow create, update: if owns(uid)
          && stateId == 'progress'
          && validProgressDocument();
      }

      match /focusSessions/{sessionId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && validFocusSession();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
